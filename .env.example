# ==============================================================================
# Voice AI POC Environment Variables Template (.env.example)
# Copy this file to .env and fill in your confidential API keys and credentials.
# NEVER commit real API keys, tokens, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Ports Configuration
# Frontend: 5173 | Backend: 8000 | SearXNG: 8080 | Qdrant: 6333
# ------------------------------------------------------------------------------
PORT=5173
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Core AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Configuration (sarvam, groq, openai, deepgram)
# ------------------------------------------------------------------------------
STT_PROVIDER=sarvam
STT_API_KEY=your_sarvam_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v3
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Configuration (sarvam, elevenlabs, groq, openai, cartesia)
# ------------------------------------------------------------------------------
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh

# ------------------------------------------------------------------------------
# Voice Transport & Telephony Configuration
# ------------------------------------------------------------------------------
VOICE_TRANSPORT=webrtc
AUDIO_PROCESSOR=passthrough

# FreeSWITCH Integration (SIP / PSTN gateway & ESL)
FREESWITCH_ENABLED=true
FREESWITCH_HOST=freeswitch:8021
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_RTP_START=16384
FREESWITCH_RTP_END=32768
FREESWITCH_AUDIO_WS_URL=ws://backend:8000/api/webrtc/freeswitch/ws

# Twilio Telephony Integration (Outbound & Inbound fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
PUBLIC_BASE_URL=https://your-public-subdomain.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=https://your-public-subdomain.ngrok-free.app
TWILIO_VALIDATE_SIGNATURE=false

# ------------------------------------------------------------------------------
# WebRTC Network & Port Range Configuration (Docker, AWS ECS/EC2 & NAT traversal)
# ------------------------------------------------------------------------------
RTC_PORT_START=50010
RTC_PORT_END=50030
# Explicit public IP of the host/server (leave blank to auto-detect via AWS IMDS / checkip)
WEBRTC_HOST=
AUTO_DISCOVER_PUBLIC_IP=true
# Default STUN servers (comma-separated or JSON array)
ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
# Optional custom TURN server for strict firewalls/AWS ALB deployments:
# Note: If TWILIO_ACCOUNT_SID & TWILIO_AUTH_TOKEN are set above, Twilio global TURN relays are used automatically!
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ------------------------------------------------------------------------------
# Audio Pipeline & Noise Cancellation
# ------------------------------------------------------------------------------
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=16000
TELEPHONY_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_ECHO_CANCELLATION=true
AUDIO_NOISE_SUPPRESSION=true
AUDIO_AUTO_GAIN_CONTROL=false
NOISE_CANCELLATION_ENABLED=true
NOISE_CANCELLATION_PROVIDER=rnnoise

# ------------------------------------------------------------------------------
# WebCall Tool Calling & Web Search Configuration (SearXNG Port: 8080)
# ------------------------------------------------------------------------------
TOOL_CALLING_ENABLED=true
WEBCALL_TOOL_CALLING_ENABLED=true
WEBCALL_WEB_SEARCH_ENABLED=true
MAX_TOOL_CALLS_PER_TURN=3
MAX_WEB_SEARCHES_PER_SESSION=20

WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
SEARCH_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
BING_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=5.0
WEB_SEARCH_CACHE_TTL=30.0
WEB_FETCH_TIMEOUT=10.0
WEB_FETCH_MAX_BYTES=2000000

# ------------------------------------------------------------------------------
# Knowledge Base (RAG) & Vector Database Configuration (Qdrant Port: 6333)
# ------------------------------------------------------------------------------
KB_ENABLED=true
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
KB_TOP_K=5
KB_MIN_SCORE=0.70
KB_MAX_CONTEXT_TOKENS=2500
KB_CHUNK_SIZE=700
KB_CHUNK_OVERLAP=100
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Application & Network / CORS Settings
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
CORS_ALLOW_ALL=true
CORS_ORIGIN_REGEX=.*
VITE_BACKEND_URL=
CALLBACK_WORKER_ENABLED=true
