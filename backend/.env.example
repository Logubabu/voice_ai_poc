# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# STT Configuration (sarvam, groq, openai, deepgram)
STT_PROVIDER=sarvam
STT_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v3

# LLM Configuration (google, groq, openai)
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# TTS Configuration (sarvam, elevenlabs, groq, openai, cartesia)
TTS_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
TTS_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Voice Transport Configuration (webrtc, freeswitch)
VOICE_TRANSPORT=webrtc

# FreeSWITCH Integration Configuration
FREESWITCH_ENABLED=true
FREESWITCH_HOST=localhost:8021
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_AUDIO_WS_URL=ws://localhost:8000/api/webrtc/freeswitch/ws

# WebRTC Network & Port Range Configuration
RTC_PORT_START=50010
RTC_PORT_END=50030
WEBRTC_HOST=
ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Audio Pipeline Configuration
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=16000
TELEPHONY_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_ECHO_CANCELLATION=true
AUDIO_NOISE_SUPPRESSION=true
AUDIO_AUTO_GAIN_CONTROL=false

# Noise Cancellation Configuration (rnnoise, webrtc, passthrough, deepfilternet)
NOISE_CANCELLATION_ENABLED=true
NOISE_CANCELLATION_PROVIDER=rnnoise
NOISE_CANCELLATION_AGGRESSIVENESS=medium

# WebCall Tool Calling & Web Search Configuration (SearXNG Port: 8080)
WEBCALL_TOOL_CALLING_ENABLED=true
WEBCALL_WEB_SEARCH_ENABLED=true
MAX_TOOL_CALLS_PER_TURN=3
MAX_WEB_SEARCHES_PER_SESSION=20

WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
BING_API_KEY=
SEARXNG_URL=http://localhost:8080
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=5.0
WEB_SEARCH_CACHE_TTL=30.0
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_BYTES=2000000

# Knowledge Base (RAG) Configuration (Qdrant Port: 6333)
KB_ENABLED=true
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KB_TOP_K=5
KB_MIN_SCORE=0.70
KB_MAX_CONTEXT_TOKENS=2500
KB_CHUNK_SIZE=700
KB_CHUNK_OVERLAP=100
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKING_ENABLED=false
KB_CACHE_ENABLED=false
KB_SEARCH_TIMEOUT_MS=500
INGESTION_MAX_CONCURRENCY=2

# Network & CORS Configuration
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=true
CORS_ORIGIN_REGEX=.*

# Twilio Voice Integration Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
PUBLIC_BASE_URL=https://your-public-subdomain.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=https://your-public-subdomain.ngrok-free.app
TWILIO_VALIDATE_SIGNATURE=false
