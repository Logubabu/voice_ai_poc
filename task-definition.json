{
  "family": "voice-ai-task-definition",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::291200967799:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::291200967799:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "voice-ai",
      "image": "voice-ai-poc:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "voice-ai-8080-tcp"
        },
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "voice-ai-8000-tcp"
        },
        {
          "containerPort": 5173,
          "hostPort": 5173,
          "protocol": "tcp",
          "name": "voice-ai-5173-tcp"
        },
        {
          "containerPort": 5060,
          "hostPort": 5060,
          "protocol": "udp",
          "name": "voice-ai-5060-udp"
        },
        {
          "containerPort": 5060,
          "hostPort": 5060,
          "protocol": "tcp",
          "name": "voice-ai-5060-tcp"
        },
        {
          "containerPort": 8021,
          "hostPort": 8021,
          "protocol": "tcp",
          "name": "voice-ai-8021-tcp"
        },
        {
          "containerPort": 8086,
          "hostPort": 8086,
          "protocol": "tcp",
          "name": "voice-ai-8086-tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/voice-ai-task-definition",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

